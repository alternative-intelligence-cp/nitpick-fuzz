// M11 ty0203 -- meta/specs/TYPE_REFERENCE.md:203 (rule)
// quote: **A float `/` or `%` arms no
// claim: A float `/` or `%` arms no DivByZero/DivOverflow: a program whose only division is a float's compiles with a failsafe that names neither.
// expect: run:0
// wrong: REACH-002: the float division armed DivByZero/DivOverflow; or a wrong value (10)
mod:ty0203;

func:vf64 = flt64(flt64:x) never fails { pass x; };

func:m11fd = flt64(flt64:a, flt64:b) never fails { pass (a / b) + (a % b); };

func:main = int32(cstring[]:_~argv) {
    if (raw m11fd(raw vf64(7.0f64), raw vf64(2.0f64)) != 4.5f64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
