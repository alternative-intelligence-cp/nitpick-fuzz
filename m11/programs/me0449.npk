// quote: | Threading | single-threaded | multi-threaded |
// claim: A shared_arena is multi-threaded: a thread allocates in it, and after the join the owner reads the value through the handle the thread returned on a channel.
// expect: run:0
// wrong: refused, or 10
mod:me0449;

error:E1;
error:E2;
error:E3;
error:E4;
fixed Duration:J2 = Duration{ ns: 2000000000i64 };
thread async func:worker = NIL(shared_arena<int64>->:s, Channel<Handle<int64>, 3i32, 1i64>:c) joins J2 {
    Handle<int64>:h = s.alloc(77i64);
    await c.send(h, raw duration_ms(500i64)) ?! E4;
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    shared_arena<int64>:s = shared_arena_make(4i64);
    Channel<Handle<int64>, 3i32, 1i64>:ch = channel() ?! E1;
    {
        drop worker(@s, ch);
    }
    Handle<int64>:h = await ch.recv(raw duration_ms(500i64)) ?! E2;
    int64:v = s.get(h) ?! E3;
    s.destroy();
    if (v != 77i64) { exit 10i32; }
    exit 0i32;
};

