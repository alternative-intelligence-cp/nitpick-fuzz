// M11 lx0173 -- meta/specs/LEXICAL_REFERENCE.md:173 (example)
// quote: ```ebnf
// claim: The arithmetic, compound, comparison, logical and bitwise operators of the block lex and compute: a program using each gets the expected values.
// expect: run:0
// wrong: refused (an operator not lexed), or 10-15
mod:lx0173;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:a = raw v32(12i32);
    int32:b = raw v32(5i32);
    int32:x = a;
    x += 1i32; x -= 2i32; x *= 3i32; x /= 11i32; x %= 2i32;
    int32:y = raw v32(6i32);
    y &= 3i32; y |= 8i32; y ^= 1i32; y <<= 2i32; y >>= 1i32;
    if (!(a + b == 17i32 && a - b == 7i32 && a * b == 60i32 && a / b == 2i32 && a % b == 2i32)) { exit 10i32; }
    if (!(x == 1i32)) { exit 11i32; }
    if (!(y == 22i32)) { exit 12i32; }
    if (!((a == 12i32) && (a != b) && (b < a) && (b <= 5i32) && (a > b) && (a >= 12i32))) { exit 13i32; }
    if (!(((a & b) == 4i32) && ((a | b) == 13i32) && ((a ^ b) == 9i32) && ((~b) == -6i32))) { exit 14i32; }
    if (!(((b << 2i32) == 20i32) && ((a >> 2i32) == 3i32) && (!(a < b) || false))) { exit 15i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
