// quote: `destroy` only**
// claim: A `shared_arena<T>` supports alloc, get and destroy.
// expect: run:0
// wrong: refused (no destroy) or 10
mod:cc0310c;

func:v64 = int64(int64:x) never fails { pass x; };

error:E1;

func:main = int32(cstring[]:_~argv) {
    shared_arena<int64>:s = shared_arena_make(4i64);
    Handle<int64>:h = s.alloc(raw v64(5i64));
    int64:v = s.get(h) ?! E1;
    if (v != 5i64) { exit 10i32; }
    s.destroy();
    exit 0i32;
};

