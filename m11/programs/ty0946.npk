mod:ty0946;

func:v64 = int64(int64:x) never fails { pass x; };

mod:bank = {
    pub struct:Box<T> = { sealed T:v; };
    pub func:mk = Box<int64>() never fails { Box<int64>:b = Box{ v: 5i64 }; pass b; };
};
use bank.{Box};

func:main = int32(cstring[]:_~argv) {
    Box<int64>:b = raw bank.mk();
    b.v = raw v64(6i64);
    exit 0i32;
};

