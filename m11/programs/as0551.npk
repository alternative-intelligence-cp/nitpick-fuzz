// M11 as0551 -- meta/specs/AST_REFERENCE.md:551 (row)
// quote: compared at every call inside the function's recursive group
// claim: A function's `decreases` is compared at every call inside its recursive group: f and g calling each other with an unchanged measure trap DecreasesViolated.
// expect: trap:DecreasesViolated
// wrong: StackExhausted (the group not checked)
mod:as0551;

func:v64 = int64(int64:x) never fails { pass x; };

func:f = int64(int64:n) decreases n never fails {
    if (n <= 0i64) { pass 0i64; }
    pass (raw g(n));
};
func:g = int64(int64:n) decreases n never fails {
    if (n <= 0i64) { pass 0i64; }
    pass (raw f(n));
};

func:main = int32(cstring[]:_~argv) {
    int64:r = raw f(raw v64(3i64));
    if (r == 0i64) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
