// M11 io0104 -- meta/specs/IO_REFERENCE.md:104 (row)
// quote: and lone `\r` all yield `\n`
// claim: A text reader reads `\r\n`, `\n` and a lone `\r` each as one line break: `a\r\nb\nc\rd` is four lines.
// expect: run:0
// wrong: 10-14 (a break kind not recognised, or an empty line minted)
mod:io0104;

error:E1;
error:E2;
error:E9;

async func:main = int32(cstring[]:_~argv) {
    wild int8->:fds = alloc(8i64);
    discard(sys(293i64, fds, 2048i64) ?! E9);
    wild int32->:fdi = fds =>! wild int32->;
    int32:rfd = fdi[0i64];
    int32:wfd = fdi[1i64];
    dalloc(fds);
    ByteReader:br = ByteReader{ src: own_fd(rfd =>! fd) };
    {
        ByteWriter:w = ByteWriter{ sink: own_fd(wfd =>! fd) };
        int64:k = await w.write(string_bytes("a\r\nb\nc\rd"), raw duration_ms(500i64)) ?! E1;
        if (k != 8i64) { exit 20i32; }
    }
    TextReader<ByteReader>:tr = raw text_reader(move(br));
    string:l1 = await text_read_line(@tr, raw duration_ms(500i64)) ?! E2;
    string:l2 = await text_read_line(@tr, raw duration_ms(500i64)) ?! E2;
    string:l3 = await text_read_line(@tr, raw duration_ms(500i64)) ?! E2;
    string:l4 = await text_read_line(@tr, raw duration_ms(500i64)) ?! E2;
    if (!(string_equals(l1, "a"))) { exit 10i32; }
    if (!(string_equals(l2, "b"))) { exit 11i32; }
    if (!(string_equals(l3, "c"))) { exit 12i32; }
    if (!(string_equals(l4, "d"))) { exit 13i32; }
    Result<string>:l5 = await text_read_line(@tr, raw duration_ms(500i64));
    if (!l5.is_error) { exit 14i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (E1) { exit 81i32; },
        (E2) { exit 82i32; },
        (E9) { exit 89i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
