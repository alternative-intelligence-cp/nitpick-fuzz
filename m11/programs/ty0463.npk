// M11 ty0463 -- meta/specs/TYPE_REFERENCE.md:463 (row)
// quote: | `int1024` /
// claim: `int1024` / `uint1024` are 128 bytes with alignment 16.
// expect: run:0
// wrong: 10: int1024 is not 128 bytes; 11: it does not sit at offset 16 after an int8 (an alignment other than 16); 12: uint1024 is not 128 bytes; 13: it does not sit at offset 16 after an int8 (an alignment other than 16)
mod:ty0463;

struct:P0 = { int8:a; int1024:v; };
struct:P1 = { int8:a; uint1024:v; };

func:main = int32(cstring[]:_~argv) {
    if (#size_of<int1024>() != 128i64) { exit 10i32; }
    if (#size_of<P0>() != 144i64) { exit 11i32; }
    if (#size_of<uint1024>() != 128i64) { exit 12i32; }
    if (#size_of<P1>() != 144i64) { exit 13i32; }
    exit 0i32;
};

