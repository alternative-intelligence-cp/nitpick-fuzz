// M11 me0305 -- meta/specs/MEMORY_REFERENCE.md:305 (rule)
// quote: a garbage
// claim: dalloc proves a pointer lies in allocator-owned memory first: a garbage pointer is one of the allocator's traps, never a wild load (failsafe here maps HeapBadRequest, HeapOom and Unreachable to 42, MachineFault to 43).
// expect: run:42
// wrong: 43: a fault at a wild load; 10: the free went through
mod:me0305;

func:v64 = int64(int64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    wild int8->:g = #wild_ptr<int8>(raw v64(4096i64));
    dalloc(g);
    exit 10i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 42i32; },
        (HeapOom) { exit 42i32; },
        (Unreachable) { exit 42i32; },
        (MachineFault) { exit 43i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
