// M11 ty0187b -- meta/specs/TYPE_REFERENCE.md:187 (rule)
// quote: `fcmp` ordered predicates
// claim: flt64 `!=` lowers to `fcmp une` and `<` to the ordered `fcmp olt`.
// expect: ir:(?s)\A(?=.*?^define [^@\n]*@"?(?:[\w$]+\.)*m11ne"?\((?=(?:(?!\n\}).)*?fcmp une double ))(?=.*?^define [^@\n]*@"?(?:[\w$]+\.)*m11fl"?\((?=(?:(?!\n\}).)*?fcmp olt double ))
// wrong: `fcmp one` for `!=`, or an unordered `<`
mod:ty0187b;

func:vf64 = flt64(flt64:x) never fails { pass x; };

func:m11ne = bool(flt64:a, flt64:b) never fails { pass a != b; };
func:m11fl = bool(flt64:a, flt64:b) never fails { pass a < b; };

func:main = int32(cstring[]:_~argv) {
    if (!(raw m11ne(raw vf64(1.0f64), raw vf64(2.0f64)))) { exit 10i32; }
    if (!(raw m11fl(raw vf64(1.0f64), raw vf64(2.0f64)))) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
