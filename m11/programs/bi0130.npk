// M11 bi0130 -- meta/specs/BUILTIN_REFERENCE.md:130 (row)
// quote: | `calloc` |
// claim: calloc allocates count*size ZERO-initialised bytes.
// expect: run:0
// wrong: a reused block's old bytes (10)
mod:bi0130;

func:v64 = int64(int64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    wild int8->:d = alloc(64i64);
    wild uint8->:du = d =>! wild uint8->;
    int64:i = 0i64;
    while (i < 64i64) decreases 64i64 - i { du[i] = 255u8; i = i + 1i64; }
    dalloc(d);
    wild int8->:p = calloc(raw v64(8i64), raw v64(8i64));
    wild uint8->:u = p =>! wild uint8->;
    int64:j = 0i64;
    while (j < 64i64) decreases 64i64 - j {
        if (u[j] != 0u8) { exit 10i32; }
        j = j + 1i64;
    }
    dalloc(p);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
