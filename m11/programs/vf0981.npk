// M11 vf0981 -- meta/specs/VERIFICATION_REFERENCE.md:981 (rule)
// quote: `fcmp` writes (`==` is `fp.eq`, `!=` its negation, so NaN compares as the
// claim: The machine's float compares are the ordered ones with `!=` their negation: NaN == NaN is false, NaN != NaN is true, and NaN < 1 and NaN >= 1 are both false.
// expect: run:0
// wrong: unordered compares (NaN == NaN true: 10; NaN < 1 or >= 1 true: 12, 13) or an ordered `!=` (11)
mod:vf0981;

func:vf64 = flt64(flt64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    flt64:n = raw vf64(0.0f64) / raw vf64(0.0f64);
    if (n == n) { exit 10i32; }
    if (!(n != n)) { exit 11i32; }
    if (n < 1.0f64) { exit 12i32; }
    if (n >= 1.0f64) { exit 13i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
