// M11 mc0356 -- meta/specs/MACRO_REFERENCE.md:356 (rule)
// quote: Exceeding either is `NITPICK-TYPE-025`
// claim: Exceeding either evaluation bound is NITPICK-TYPE-025: two comptime functions recursing into each other are refused with it.
// expect: refuse:NITPICK-TYPE-025
// wrong: a crash or a hang, or 'not a constant' instead of TYPE-025
mod:mc0356;

comptime func:ping_c = int32(int32:n) never fails { pass (raw pong_c(n + 1i32)); };
comptime func:pong_c = int32(int32:n) never fails { pass (raw ping_c(n + 1i32)); };

func:main = int32(cstring[]:_~argv) {
    int32:a = comptime(ping_c(0i32));
    discard(a);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
