// M11 ty2048 -- meta/specs/TYPE_REFERENCE.md:2048 (row)
// quote: Arithmetic on a SIGNED operand, logical on an UNSIGNED one
// claim: `>>` is `ashr` on a signed operand and `lshr` on an unsigned one.
// expect: ir:(?s)\A(?=.*?^define [^@\n]*@"?(?:[\w$]+\.)*m11a"?\((?=(?:(?!\n\}).)*?\bashr i32\b))(?=.*?^define [^@\n]*@"?(?:[\w$]+\.)*m11l"?\((?=(?:(?!\n\}).)*?\blshr i32\b))
// wrong: one shift for both
mod:ty2048;

func:v32 = int32(int32:x) never fails { pass x; };
func:vu32 = uint32(uint32:x) never fails { pass x; };

func:m11a = int32(int32:a, int32:b) never fails { pass (a >> b); };
func:m11l = uint32(uint32:a, uint32:b) never fails { pass (a >> b); };

func:main = int32(cstring[]:_~argv) {
    if (raw m11a(raw v32(-8i32), 1i32) != -4i32) { exit 10i32; }
    if (raw m11l(raw vu32(8u32), 1u32) != 4u32) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
