// M11 ty0671 -- meta/specs/TYPE_REFERENCE.md:671 (row)
// quote: | `tbb32` |
// claim: `tbb32` is 4 bytes with alignment 4; its valid range is symmetric, -(2^31-1) .. 2^31-1, and one step past either end is ERR.
// expect: run:0
// wrong: 10: tbb32 is not 4 bytes; 11: it does not sit at offset 4 after an int8; 20/22: an end of the range is not a value; 21/23: one past it is a number (wrapped)
mod:ty0671;

func:vt32 = tbb32(tbb32:x) never fails { pass x; };

struct:P0 = { int8:a; tbb32:v; };

func:main = int32(cstring[]:_~argv) {
    if (#size_of<tbb32>() != 4i64) { exit 10i32; }
    if (#size_of<P0>() != 8i64) { exit 11i32; }
    tbb32:mx = raw vt32(2147483647tbb32);
    if (is_err(mx)) { exit 20i32; }
    if (!(is_err(mx + raw vt32(1tbb32)))) { exit 21i32; }
    tbb32:mn = 0tbb32 - mx;
    if (is_err(mn)) { exit 22i32; }
    if (!(is_err(mn - raw vt32(1tbb32)))) { exit 23i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
