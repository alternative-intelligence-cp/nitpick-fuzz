// M11 ty1595 -- meta/specs/TYPE_REFERENCE.md:1595 (rule)
// quote: Dimensional analysis types carry unit metadata at compile time only.
// claim: A dimensional value is its base numeric type at run time: a `dim256<Meters>` parameter and a `tfp256` one have the same IR type.
// expect: ir:(?s)\A(?=.*?@"?(?:[\w$]+\.)*m11d"?\(([^ ,)]+))(?=.*?@"?(?:[\w$]+\.)*m11t"?\(\1[ ,)])
// wrong: a unit carried at run time: another IR type
mod:ty1595;

func:m11d = dim256<Meters>(dim256<Meters>:x) never fails { pass x; };
func:m11t = tfp256(tfp256:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    dim256<Meters>:d = raw m11d(1.5dim256<Meters>);
    tfp256:t = raw m11t(1.5tfp256);
    if ((d => tfp256) != t) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
