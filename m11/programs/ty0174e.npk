// M11 ty0174e -- meta/specs/TYPE_REFERENCE.md:174 (rule)
// quote: holds, moves
// claim: flt128 is storage: a value is held in a local and a struct field and moved through a function.
// expect: run:0
// wrong: refused: a flt128 cannot be held or moved; or the struct's other field corrupted (10)
mod:ty0174e;

struct:Q = { flt128:v; int32:k; };
func:m11qm = flt128(flt128:a) never fails { flt128:b = a; pass b; };

func:main = int32(cstring[]:_~argv) {
    flt128[2]:z = [];
    flt128:x = raw m11qm(z[1i64]);
    Q:q = Q{ v: x, k: 7i32 };
    flt128:y = q.v;
    discard(y);
    if (q.k != 7i32) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
