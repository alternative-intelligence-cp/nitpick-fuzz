// M11 io0232 -- meta/specs/IO_REFERENCE.md:232 (rule)
// quote: Seeking a buffered stream discards the read buffer
// claim: Seeking a buffered stream discards its read buffer: after a text reader has read `ab` (buffering `cd`), seeking to the start and reading gives `ab` again.
// expect: run:0
// wrong: refused (a buffered stream has no seek) or 12 (`cd`: the buffer survived)
mod:io0232;

error:E1;
error:E2;
error:E3;
error:E9;
func:scrub = NIL(Path:p) never fails {
    Result<cstring>:c = to_cstring(p.text);
    if (c.is_error) { pass NIL; }
    discard(sys(263i64, (0i64 - 100i64), c.value.ptr, 0i64) ?| 0i64);
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    string:me = int_to_string(sys(39i64) ?! E9);
    Path:p = path_parse(string_concat("/tmp/npk_m11_io0232.", string_concat(me, ".tmp"))) ?! E9;
    {
        ByteWriter:fw = byte_writer_create(p, raw duration_ms(500i64)) ?! E9;
        int64:fk = await fw.write(string_bytes("ab\ncd\n"), raw duration_ms(500i64)) ?! E9;
        if (fk != 6i64) { exit 20i32; }
    }
    ByteReader:br = byte_reader_open(p, raw duration_ms(500i64)) ?! E9;
    TextReader<ByteReader>:tr = raw text_reader(move(br));
    Duration:d = raw duration_ms(500i64);
    string:l1 = await text_read_line(@tr, d) ?! E1;
    if (!(string_equals(l1, "ab"))) { exit 10i32; }
    int64:np = await tr.seek(Whence.Start, 0i64, d) ?! E2;
    if (np != 0i64) { exit 11i32; }
    string:l2 = await text_read_line(@tr, d) ?! E3;
    if (!(string_equals(l2, "ab"))) { exit 12i32; }
    drop scrub(p);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (E1) { exit 81i32; },
        (E2) { exit 82i32; },
        (E3) { exit 83i32; },
        (E9) { exit 89i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
