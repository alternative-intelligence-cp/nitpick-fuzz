// claim: `failsafe`'s `exit` operand is checked positive: a computed zero is EnsuresViolated, and the trap route's re-entry rule ends the process at 70.
// expect: run:70
// wrong: unchecked: the process exits 0 (a trap reported as success), or failsafe re-entered (33)
mod:vf0919;

func:v32 = int32(int32:x) never fails { pass x; };

error:E9;
func:broken = int32() { fail E9; };
func:main = int32(cstring[]:_~argv) {
    int32:v = broken() ?! E9;
    exit (v + 1i32);
