// M11 ty1635 -- meta/specs/TYPE_REFERENCE.md:1635 (rule)
// quote: **The five invariants hold after every operation**
// claim: The invariants hold: -(2 5/8) is whole -3 and num 3 over 8 (num >= 0 when whole != 0, the sign on whole), and 1/2 - 5/6 is whole 0, num -1, denom 3 (the sign on num).
// expect: run:0
// wrong: 10-15: an invariant broken
mod:ty1635;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    frac32:two58 = (raw v32(2i32) => frac32) + ((raw v32(5i32) => frac32) / (8i32 => frac32));
    frac32:n = -two58;
    if (n.whole != -3i32) { exit 10i32; }
    if (n.num != 3i32) { exit 11i32; }
    if (n.denom != 8u32) { exit 12i32; }
    frac32:d = ((raw v32(1i32) => frac32) / (2i32 => frac32)) - ((raw v32(5i32) => frac32) / (6i32 => frac32));
    if (d.whole != 0i32) { exit 13i32; }
    if (d.num != -1i32) { exit 14i32; }
    if (d.denom != 3u32) { exit 15i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
