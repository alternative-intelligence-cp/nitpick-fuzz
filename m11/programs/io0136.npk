// M11 io0136 -- meta/specs/IO_REFERENCE.md:136 (row)
// quote: | `stderr` | **unbuffered, always** |
// claim: stderr is unbuffered: with fd 2 on a pipe, a partial line written through std_err() is delivered at once.
// expect: run:0
// wrong: 10: the partial line was held back (buffered)
mod:io0136;

error:E1;
error:E2;
error:E9;

async func:main = int32(cstring[]:_~argv) {
    wild int8->:fds = alloc(8i64);
    discard(sys(293i64, fds, 2048i64) ?! E9);
    wild int32->:fdi = fds =>! wild int32->;
    int32:rfd = fdi[0i64];
    int32:wfd = fdi[1i64];
    dalloc(fds);
    discard(sys(33i64, wfd => int64, 2i64) ?! E9);
    ByteReader:r = ByteReader{ src: own_fd(rfd =>! fd) };
    TextWriter<ByteWriter>:se = std_err() ?! E1;
    await text_write_str(@se, "ab", raw duration_ms(500i64)) ?! E2;
    uint8[8]:buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    Result<int64>:n = await r.read(buf[0i64...8i64], raw duration_ms(500i64));
    if (n.is_error) { exit 10i32; }
    if (n.value != 2i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (E1) { exit 81i32; },
        (E2) { exit 82i32; },
        (E9) { exit 89i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
