// M11 ty1739 -- meta/specs/TYPE_REFERENCE.md:1739 (example)
// quote: ```llvm
// claim: A buffer is `{ ptr, i64, i64 }`: 24 bytes, alignment 8.
// expect: run:0
// wrong: 10: buffer is not 24 bytes; 11: it does not sit at offset 8 after an int8
mod:ty1739;

struct:P0 = { int8:a; buffer:v; };

func:main = int32(cstring[]:_~argv) {
    if (#size_of<buffer>() != 24i64) { exit 10i32; }
    if (#size_of<P0>() != 32i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
