// wrong: accepted
mod:as0452;

func:v64 = int64(int64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int64:i = raw v64(0i64);
    int64:s = 0i64;
    while (i < 3i64) decreases 3i64 - i { s = s + $; i = i + 1i64; }
    exit 0i32;
};

