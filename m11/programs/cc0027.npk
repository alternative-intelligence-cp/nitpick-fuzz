// M11 cc0027 -- meta/specs/CONCURRENCY_REFERENCE.md:27 (rule)
// quote: Every thread runs an executor
// claim: Every thread runs an executor: a thread's body spawns a task, awaits the channel it fills, and reports the value plus one.
// expect: run:0
// wrong: refused, 10, or a failsafe arm 82-86: a thread cannot run tasks of its own
mod:cc0027;

error:E1;
error:E2;
error:E3;
error:E4;
error:E5;
error:E6;
fixed Duration:J2 = Duration{ ns: 2000000000i64 };
async func:child = NIL(Channel<int32, 3i32, 1i64>:c) {
    await c.send(7i32, raw duration_ms(500i64)) ?! E1;
    pass NIL;
};
thread async func:tbody = NIL(Channel<int32, 4i32, 1i64>:out) joins J2 {
    Channel<int32, 3i32, 1i64>:inner = channel() ?! E2;
    drop child(inner);
    int32:v = await inner.recv(raw duration_ms(1000i64)) ?! E3;
    await out.send(v + 1i32, raw duration_ms(500i64)) ?! E4;
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    Channel<int32, 4i32, 1i64>:out = channel() ?! E5;
    drop tbody(out);
    int32:r = await out.recv(raw duration_ms(2000i64)) ?! E6;
    if (r != 8i32) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (E1) { exit 81i32; },
        (E2) { exit 82i32; },
        (E3) { exit 83i32; },
        (E4) { exit 84i32; },
        (E5) { exit 85i32; },
        (E6) { exit 86i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
