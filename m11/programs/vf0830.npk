func:take_9 = Lease() acquires 9i32 { pass Lease{ v: 9i32 }; };
trait:Storage = { func:commit = NIL(Self:self) acquires <= 3i32; };
struct:Loose = { int32:v; };
impl:Loose:Storage = {
    pub func:commit = NIL(Self:self) never fails {
        Lease:g = take_9() ?! E9;
        discard(g.v);
        pass NIL;
    };
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

