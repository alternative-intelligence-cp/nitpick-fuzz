// quote: is a view of a temporary
// claim: A temporary handed to a callee that views it is a view of a temporary: BORROW-012.
// expect: refuse:BORROW-012
// wrong: accepted: a view of storage dropped at the statement's end
mod:me0228;

func:main = int32(cstring[]:_~argv) {
    uint8[]:v = string_bytes(string_concat("ab", "c"));
    if (v[0i64] != 97u8) { exit 10i32; }
    exit 0i32;
};

