mod:ty1169;

trait:Pr = { func:p = int32(Self->:self) never fails; };
enum:Opt<T: Pr> = { Some(T); None; };
struct:Point = { int32:x; };

func:main = int32(cstring[]:_~argv) {
    discard(Opt.Some(Point{ x: 1i32 }));
    exit 0i32;
};

