// M11 io0103 -- meta/specs/IO_REFERENCE.md:103 (row)
// quote: | Translation | **none, ever** | on |
// claim: A byte stream never translates: `a\r\nb\n` written by a ByteWriter reads back as the same 5 bytes.
// expect: run:0
// wrong: 10-13: a byte stream translated line endings
mod:io0103;

error:E1;
error:E2;
error:E9;

async func:main = int32(cstring[]:_~argv) {
    wild int8->:fds = alloc(8i64);
    discard(sys(293i64, fds, 2048i64) ?! E9);
    wild int32->:fdi = fds =>! wild int32->;
    int32:rfd = fdi[0i64];
    int32:wfd = fdi[1i64];
    dalloc(fds);
    ByteReader:r = ByteReader{ src: own_fd(rfd =>! fd) };
    {
        ByteWriter:w = ByteWriter{ sink: own_fd(wfd =>! fd) };
        int64:k = await w.write(string_bytes("a\r\nb\n"), raw duration_ms(500i64)) ?! E1;
        if (k != 5i64) { exit 20i32; }
    }
    uint8[8]:buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    int64:n = await r.read(buf[0i64...8i64], raw duration_ms(500i64)) ?! E2;
    if (n != 5i64) { exit 10i32; }
    if (buf[1i64] != 13u8) { exit 11i32; }
    if (buf[2i64] != 10u8) { exit 12i32; }
    if (buf[4i64] != 10u8) { exit 13i32; }
    exit 0i32;
};

