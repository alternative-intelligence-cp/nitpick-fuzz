// M11 ty0491 -- meta/specs/TYPE_REFERENCE.md:491 (row)
// quote: | `tfp32` |
// claim: `tfp32` is 4 bytes, alignment 4, format Q16.16: the least step is 2^-16 and the integer part tops out at 2^15 - 1.
// expect: run:0
// wrong: 10: tfp32 is not 4 bytes; 11: it does not sit at offset 4 after an int8 (an alignment other than 4); 12: another fraction width; 13: an integer part narrower than Q16.16; 14: wider (no ERR past the top)
mod:ty0491;

struct:P0 = { int8:a; tfp32:v; };
func:vtf32 = tfp32(tfp32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    if (#size_of<tfp32>() != 4i64) { exit 10i32; }
    if (#size_of<P0>() != 8i64) { exit 11i32; }
    tfp32:eps = raw vtf32(0.0000152587890625tfp32);
    if (((eps * 256.0tfp32) * 256.0tfp32) != 1.0tfp32) { exit 12i32; }
    tfp32:top = raw vtf32(32767.5tfp32);
    if (is_err(top + 0.25tfp32)) { exit 13i32; }
    if (!(is_err(top + 1.0tfp32))) { exit 14i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
