// M11 ty0810 -- meta/specs/TYPE_REFERENCE.md:810 (rule)
// quote: one family within itself — value-preserving, the sentinel maps
// claim: Within the ternary family a cast preserves the value and maps the sentinel: trit -1 => tryte is -1, and trit ERR => tryte is ERR.
// expect: run:0
// wrong: refused, or 10: a value changed; 11: the sentinel became a number
mod:ty0810;

func:vtt = trit(trit:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    trit:a = 0Tt;
    tryte:w = raw vtt(a) => tryte;
    if ((w => int32) != -1i32) { exit 10i32; }
    trit:e = ERR;
    tryte:we = raw vtt(e) => tryte;
    if (!(is_err(we))) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
