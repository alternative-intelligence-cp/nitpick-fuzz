// M11 ty1657 -- meta/specs/TYPE_REFERENCE.md:1657 (rule)
// quote: **`ToString`**: "whole num/denom"
// claim: ToString renders "3 1/3", "-2 5/8", "0" and "ERR".
// expect: run:0
// wrong: 11: the canonical parts rendered ("-3 3/8"); 10/12/13: another rendering
mod:ty1657;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    frac32:a = (raw v32(3i32) => frac32) + ((raw v32(1i32) => frac32) / (3i32 => frac32));
    string:s = `&{ a }`;
    if (!(string_equals(s, "3 1/3"))) { exit 10i32; }
    frac32:two58 = (raw v32(2i32) => frac32) + ((raw v32(5i32) => frac32) / (8i32 => frac32));
    frac32:n = -two58;
    string:t = `&{ n }`;
    if (!(string_equals(t, "-2 5/8"))) { exit 11i32; }
    frac32:z = raw v32(0i32) => frac32;
    string:u = `&{ z }`;
    if (!(string_equals(u, "0"))) { exit 12i32; }
    frac32:e = ERR;
    string:w = `&{ e }`;
    if (!(string_equals(w, "ERR"))) { exit 13i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
