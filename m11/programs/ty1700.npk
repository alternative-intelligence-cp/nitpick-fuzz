// M11 ty1700 -- meta/specs/TYPE_REFERENCE.md:1700 (rule)
// quote: **`ToString`**: "3+4i" / "3-4i"
// claim: ToString renders "3+4i" and "3-4i", and a tfp ERR pair "ERR".
// expect: run:0
// wrong: refused, or 10-12: another rendering
mod:ty1700;

func:vf64 = flt64(flt64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    complex<flt64>:a = complex(raw vf64(3.0f64), 4.0f64);
    string:s = `&{ a }`;
    if (!(string_equals(s, "3+4i"))) { exit 10i32; }
    complex<flt64>:b = complex(raw vf64(3.0f64), -4.0f64);
    string:t = `&{ b }`;
    if (!(string_equals(t, "3-4i"))) { exit 11i32; }
    tfp32:e = ERR;
    complex<tfp32>:c = complex(e, e);
    string:u = `&{ c }`;
    if (!(string_equals(u, "ERR"))) { exit 12i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
