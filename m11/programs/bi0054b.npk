// M11 bi0054b -- meta/specs/BUILTIN_REFERENCE.md:54 (rule)
// quote: a parameter, a local, a `for` binding or a `pick`
// claim: A function-typed PARAMETER named after a builtin is NITPICK-RESOLVE-001.
// expect: refuse:NITPICK-RESOLVE-001
// wrong: accepted: the parameter shadows the builtin
mod:bi0054b;

func:eight = int64() never fails { pass 8i64; };
func:callit = int64(func int64() never fails:mono_now) never fails { pass (raw mono_now()); };

func:main = int32(cstring[]:_~argv) {
    if ((raw callit(eight)) != 8i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
