mod:bi0152b;

func:after = int32(cstring[]:argv, int64:n) never fails {
    if (argv.len != n) { pass 10i32; }
    if (argv[0i64].len == 0i64) { pass 11i32; }
    cstring[]:env = environ();
    if (env.len != 0i64) { pass 12i32; }
    pass 0i32;
};

func:main = int32(cstring[]:argv) {
