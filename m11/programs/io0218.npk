// M11 io0218 -- meta/specs/IO_REFERENCE.md:218 (rule)
// quote: A MOVE into a spawn is legal
// claim: A move of a stream into a thread spawn is legal: the thread writes through the moved writer, and its scope's close gives the reader end of input.
// expect: run:0
// wrong: refused, or 10-12
mod:io0218;

error:E1;
error:E2;
error:E3;
error:E9;
fixed Duration:J2 = Duration{ ns: 2000000000i64 };
thread async func:feed = NIL(move ByteWriter:w) joins J2 {
    int64:n = await w.write(string_bytes("xyz"), raw duration_ms(500i64)) ?! E1;
    if (n != 3i64) { fail E2; }
    pass NIL;
};

async func:main = int32(cstring[]:_~argv) {
    wild int8->:fds = alloc(8i64);
    discard(sys(293i64, fds, 2048i64) ?! E9);
    wild int32->:fdi = fds =>! wild int32->;
    int32:rfd = fdi[0i64];
    int32:wfd = fdi[1i64];
    dalloc(fds);
    ByteReader:r = ByteReader{ src: own_fd(rfd =>! fd) };
    ByteWriter:w = ByteWriter{ sink: own_fd(wfd =>! fd) };
    drop feed(move(w));
    uint8[8]:buf = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    int64:n = await r.read(buf[0i64...8i64], raw duration_ms(1000i64)) ?! E3;
    if (n != 3i64) { exit 10i32; }
    Result<int64>:e = await r.read(buf[0i64...8i64], raw duration_ms(1000i64));
    if (!e.is_error) { exit 11i32; }
    if (e.err != IoEof) { exit 12i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StaleHandle) { exit 100i32; },
        (DeadlineExceeded) { exit 101i32; },
        (ChannelClosed) { exit 102i32; },
        (DriverLeak) { exit 103i32; },
        (IoEof) { exit 104i32; },
        (WouldBlock) { exit 105i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (Interrupted) { exit 118i32; },
        (NotFound) { exit 119i32; },
        (Exists) { exit 120i32; },
        (CrossDevice) { exit 121i32; },
        (BadPath) { exit 122i32; },
        (E1) { exit 81i32; },
        (E2) { exit 82i32; },
        (E3) { exit 83i32; },
        (E9) { exit 89i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
