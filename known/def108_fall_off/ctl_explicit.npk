// CONTROL: the same function leaving on every path -- accepted at both pins,
// exits 0 (the error path is taken).
mod:ctl_explicit;

error:EBad;

func:g = int64(int64:x) {
    if (x > 0i64) { pass 1i64; }
    fail EBad;
};

func:main = int32(cstring[]:_~argv) {
    Result<int64>:r = g(0i64);
    if (r.is_error) { exit 0i32; }
    exit 12i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (EBad)              { exit 89i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
