// DEF-108 / O-N26: a FALLIBLE function with a path that falls off. Before
// FLOW-001 that path was a SUCCESS carrying 0: main exits 12.
mod:case2_fallible_missing_path;

func:g = int64(int64:x) {
    if (x > 0i64) { pass 1i64; }
};

func:main = int32(cstring[]:_~argv) {
    Result<int64>:r = g(0i64);
    if (r.is_error) { exit 0i32; }
    exit 12i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
