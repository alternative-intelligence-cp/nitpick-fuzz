mod:ctl_move_param;
struct:Box = {
    string:s;
};
func:overwrite_m = int64(move Box:b) never fails {
    b.s = string_concat("xyzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", "w");
    uint8[]:bs = string_bytes(b.s);
    if (bs[0i64] == 120u8) { pass 0i64; }
    pass 1i64;
};
func:main = int32(cstring[]:_~argv) {
    Box:b = Box{ s: string_concat("abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "c") };
    if ((raw overwrite_m(move(b))) != 0i64) { exit 23i32; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; }, (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; }, (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; }, (MachineFault) { exit 107i32; }, (*) { exit 99i32; }
    }
    exit 9i32;
};
