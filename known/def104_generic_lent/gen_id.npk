mod:gen_id;
func:id<T> = T(T:x) never fails {
    pass x;
};
func:twice = int64() never fails {
    string:a = string_concat("abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "c");
    string:b = raw id::<string>(a);
    pass string_byte_length(b);
};
func:main = int32(cstring[]:_~argv) {
    int64:n = raw twice();
    if (n != 68i64) { exit 3i32; }
    exit 0i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; }, (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; }, (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; }, (MachineFault) { exit 107i32; }, (*) { exit 99i32; }
    }
    exit 9i32;
};
