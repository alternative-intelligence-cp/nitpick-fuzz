// DEF-106 / O-N24: a write INTO a plain element of a fixed array; the read
// after it tells a dropped write (11) from a stored one (0).
mod:case2_plain_elem;

fixed int64[2]:FI = [1i64, 2i64];

func:put = int64() never fails {
    FI[1i64] = 7i64;
    pass FI[1i64];
};

func:main = int32(cstring[]:_~argv) {
    if (raw put() != 7i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
