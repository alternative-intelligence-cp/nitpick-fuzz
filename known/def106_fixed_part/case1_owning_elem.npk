// DEF-106 / O-N24: a write INTO an owning element of a fixed array.
mod:case1_owning_elem;

fixed string[2]:FA = ["alpha", "beta"];

func:put = int64() never fails {
    FA[1i64] = "gamma";
    pass 0i64;
};

func:main = int32(cstring[]:_~argv) {
    if (raw put() != 0i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (OutOfBounds)       { exit 94i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (DivByZero)         { exit 97i32; },
        (DivOverflow)       { exit 98i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
