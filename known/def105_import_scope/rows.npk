mod:rows;
// The declaring module: a struct, a table of it, a scalar of it, and a
// function returning it. Nothing here is wrong; every importer below asks
// for one of these, and x is 3 in row 1 and in ONE.
pub struct:Row = { int64:x; int64:y; };
pub fixed Row[2]:ROWS = [
    Row{ x: 1i64, y: -2i64 },
    Row{ x: 3i64, y: -4i64 }
];
pub fixed Row:ONE = Row{ x: 3i64, y: -4i64 };
pub func:mk = Row(int64:v) never fails {
    pass Row{ x: v, y: 0i64 - v };
};
