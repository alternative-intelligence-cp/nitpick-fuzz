mod:wild_load_to_ignoring_callee;
func:ign = int32(int64:_~x) never fails { pass 0i32; };
func:main = int32(cstring[]:_~argv) {
    wild int64->:p = NULL;
    int64:v = <-p;
    int32:r = raw ign(v);
    exit r;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
