// F-011, the memory face: the outer binding is an `int32[4]`, the loop's an
// `int32`. `v[3]` after the loop indexes the loop's 4-byte slot as the array.
// The reference's answer: 44 (exit 0). Exit 10: 7 (the loop's last value, a
// neighbour); exit 11: any other value -- bytes past the slot.
mod:leak_array_read_past_slot;

func:v64 = int64(int64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32[4]:v = [11i32, 22i32, 33i32, 44i32];
    int32[3]:src = [5i32, 6i32, 7i32];
    for (int32:v in src) { discard(v); }
    int32:x = v[raw v64(3i64)];
    if (x == 44i32) { exit 0i32; }
    if (x == 7i32) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
