// F-011: the outer binding is a `string`, the loop's an `int64`. npkc accepts
// the program and emits IR that llc and opt reject ("extractvalue operand
// must be aggregate type"): the use after the loop is the loop's i64 slot.
// The reference's answer: it runs, the length is 6 (exit 0).
mod:leak_string_invalid_ir;

func:main = int32(cstring[]:_~argv) {
    string:i = string_concat("abc", "def");
    int64:s = 0i64;
    for (int64:i in 0i64...3i64) { s = s + i; }
    if (string_byte_length(i) != 6i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
