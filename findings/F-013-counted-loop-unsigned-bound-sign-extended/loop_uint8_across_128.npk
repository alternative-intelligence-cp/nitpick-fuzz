// F-013: `loop(100u8, 200u8, 1u8)` -- an ascending uint8 counted loop.
// The reference's answer: 100 trips, `$` from 100 to 199 (exit 0).
// Exit 10: 156 trips from 100 DOWN to -55 -- 200 sign-extended to -56.
mod:loop_uint8_across_128;

func:vu8 = uint8(uint8:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:n = 0i32;
    int64:first = -1i64;
    int64:last = -1i64;
    loop (raw vu8(100u8), raw vu8(200u8), 1u8) {
        if (n == 0i32) { first = $; }
        last = $;
        n = n + 1i32;
    }
    if (n == 100i32 && first == 100i64 && last == 199i64) { exit 0i32; }
    if (n == 156i32 && first == 100i64 && last == -55i64) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
