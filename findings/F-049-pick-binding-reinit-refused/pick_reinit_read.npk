mod:pick_reinit_read;
error:E9;
func:mk = string() never fails {
    pass string_concat("abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "c");
};
func:nw = string() never fails {
    pass string_concat("xyzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz", "w");
};
func:sn = string() never fails {
    pass string_concat("stttttttttttttttttttttttttttttttttttttttttttt", "u");
};
func:truth = bool(int64:n) never fails {
    pass n > 0i64;
};
func:obs_s = int32(string:v) never fails {
    if (string_byte_length(v) == 0i64) { pass 23i32; }
    fixed uint8[]:bs = string_bytes(v);
    if (bs[0i64] == 97u8) { pass 21i32; }
    if (bs[0i64] == 120u8) { pass 22i32; }
    if (bs[0i64] == 115u8) { pass 25i32; }
    if (bs[0i64] == 170u8) { pass 70i32; }
    pass 24i32;
};
enum:Opt = { Non; Som(string); };
func:main = int32(cstring[]:_~argv) {
    Opt:e = Opt.Som(raw mk());
    pick (move(e)) {
        (Som(x)) {
            string:t = move(x);
            x = raw nw();
            int32:o = raw obs_s(x);
            exit o;
        },
        (*) { exit 24i32; }
    }
    exit 9i32;
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; }, (HeapOom) { exit 92i32; }, (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; }, (Unreachable) { exit 95i32; }, (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; }, (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; }, (DecreasesViolated) { exit 109i32; }, (TbbErr) { exit 110i32; },
        (E9) { exit 111i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
