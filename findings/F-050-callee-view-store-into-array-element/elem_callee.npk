mod:elem_callee;
struct:Cursor = { fixed uint8[]:src; int64:pos; };
func:fresh = string() never fails { pass string_concat("ghij", "klmn"); };
func:seti = NIL(Cursor[2]->:a, fixed uint8[]:src) never fails {
    (<-a)[0i64] = Cursor{ src: src, pos: 0i64 };
    pass NIL;
};
func:main = int32(cstring[]:_~argv) {
    Cursor[2]:cs = [Cursor{ src: string_bytes("abcdef"), pos: 0i64 }, Cursor{ src: string_bytes("abcdef"), pos: 0i64 }];
    if (cs[1i64].pos == 0i64) {
        string:t = raw fresh();
        drop seti(@cs, string_bytes(t));
    }
    exit (cs[0i64].src[0i64] => int32);
};
func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
