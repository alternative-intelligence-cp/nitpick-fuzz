// M10 q03_fallible_missing_path -- a fallible function with a path that names no failure
// claim: A fallible function names its failure on every path.
// ref: meta/specs/CONTROL_REFERENCE.md:334  "*   **Every path of a function body ends in one of these, or in `exit` (in"
// ref: meta/specs/CONTROL_REFERENCE.md:337  "`NIL` function passes `NIL`, a fallible function names its failure on every"
// expect: refuse:NITPICK-FLOW-001   (at the baseline: run:12)
// wrong: accepted: the missing path is a SUCCESS carrying 0 (exit 12)
mod:q03_fallible_missing_path;

func:v64 = int64(int64:x) never fails { pass x; };

func:g = int64(int64:x) {
    if (x > 0i64) { pass 1i64; }
};

func:main = int32(cstring[]:_~argv) {
    Result<int64>:r = g(raw v64(0i64));
    if (r.is_error) { exit 0i32; }
    exit 12i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
