// M10 l10_till_counts_from_zero -- `till(5, 1)`
// claim: `till(limit, step)` counts up from 0 to limit: `$` ranges 0..limit-1.
// ref: meta/specs/CONTROL_REFERENCE.md:198  "**`till(limit, step)`** — the simple form. Counts **up from 0** to `limit`."
// ref: meta/specs/CONTROL_REFERENCE.md:201  "x += $;  // '$' ranges from 0 to 9"
// expect: run:0
// wrong: an inclusive limit, 0..5 (10)
mod:l10_till_counts_from_zero;

func:main = int32(cstring[]:_~argv) {
    int64:n = 0i64;
    int64:s = 0i64;
    till (5i64, 1i64) { n = n + 1i64; s = s + ($); }
    if (n != 5i64) { exit 10i32; }
    if (s != 10i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
