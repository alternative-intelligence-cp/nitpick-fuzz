// M10 q08_while_true_never_completes -- a function whose body is `while (true)` passing inside, with nothing after
// claim: A `while (true)` with no `break` never completes, so nothing after it is needed.
// ref: meta/specs/CONTROL_REFERENCE.md:343  "arm ending in `fall` continues into the next arm), a `while (true)` with no"
// expect: run:0
// wrong: refused FLOW-001: an over-restriction
mod:q08_while_true_never_completes;

func:f = int64() never fails {
    // the loop passes on its first trip -- the shape under test
    while (true) unbounded { pass 5i64; }
};

func:main = int32(cstring[]:_~argv) {
    if (raw f() != 5i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
