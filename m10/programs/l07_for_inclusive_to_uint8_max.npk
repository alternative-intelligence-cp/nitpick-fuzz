// M10 l07_for_inclusive_to_uint8_max -- `for (uint8:i in 250..255)`
// claim: An inclusive range ending at 255 on a uint8 visits 255 and ends.
// ref: meta/specs/OP_REFERENCE.md:375  "| `..` | Inclusive Range | Inclusive range `[a, b]`. Used in `for` and `pick`. | `0..10` |"
// ref: meta/specs/CONTROL_REFERENCE.md:109  "or both, is `NITPICK-TYPE-072`; `for`, `loop` and `till` are bounded by"
// expect: run:0
// wrong: the counter stepped past 255 (93, or T)
mod:l07_for_inclusive_to_uint8_max;

func:vu8 = uint8(uint8:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    uint8:lo = raw vu8(250u8);
    uint8:hi = raw vu8(255u8);
    int64:n = 0i64;
    int64:s = 0i64;
    for (uint8:i in lo..hi) { n = n + 1i64; s = s + (i => int64); }
    if (n != 6i64) { exit 10i32; }
    if (s != 1515i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
