// M10 p02_fall_to_label -- `fall two;` from the first arm
// claim: `fall label;` falls through to the labelled arm, and only to it.
// ref: meta/specs/CONTROL_REFERENCE.md:60  "*   **`fall label;`** — falls through to the labelled arm. There is no implicit fallthrough."
// expect: run:0
// wrong: the fall continues past the labelled arm (111, 1111) or does not happen (1)
mod:p02_fall_to_label;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:x = raw v32(1i32);
    int32:a = 0i32;
    pick (x) {
        (1i32) { a = a + 1i32; fall two; },
        two: (2i32) { a = a + 10i32; },
        (3i32) { a = a + 100i32; },
        (*) { a = a + 1000i32; }
    }
    if (a != 11i32) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
