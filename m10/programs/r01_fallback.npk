// M10 r01_fallback -- `?|` on a failure and on a success
// claim: `expr ?| fallback` yields the value, or the fallback if the call errored.
// ref: meta/specs/OP_REFERENCE.md:70  "`expr ?| fallback` yields `expr`'s value, or `fallback` if it errored. D-167"
// expect: run:0
// wrong: the zeroed value half read on failure: 0 (exit 10)
mod:r01_fallback;

func:vb = bool(bool:x) never fails { pass x; };

error:E1;
func:f = int32(bool:ok) { if (ok) { pass 5i32; } fail E1; };

func:main = int32(cstring[]:_~argv) {
    if ((f(raw vb(false)) ?| 7i32) != 7i32) { exit 10i32; }
    if ((f(raw vb(true)) ?| 7i32) != 5i32) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (E1) { exit 81i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
