// M10 v07_int8_min_div_minus_one -- int8 minimum `/` -1
// claim: A signed minimum divided by -1 traps `DivOverflow`, at every width; the run time traps `MIN % -1` too.
// ref: meta/specs/TYPE_REFERENCE.md:477  "structural INT_MIN/−1 check, which is width-independent by construction)."
// expect: run:98
// wrong: computed wider: 128 truncates back to -128 with no trap (10)
mod:v07_int8_min_div_minus_one;

func:v8 = int8(int8:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int8:m = raw v8(-127i8) - raw v8(1i8);
    int8:q = m / raw v8(-1i8);
    if (q < 0i8) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
