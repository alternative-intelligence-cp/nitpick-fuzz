// M10 c01_widen_signed_keeps_value -- `=>` widening a negative signed value
// claim: `=>` accepts a conversion only when every source value is representable in the target, so the value is kept: a negative value sign-extends.
// ref: meta/specs/DECISIONS.md:6691  "A conversion is lossless when every value of the source type is representable"
// ref: meta/specs/OP_REFERENCE.md:351  "| `=>` | Safe Cast | Checked cast."
// expect: run:0
// wrong: zero-extension: -1 becomes 4294967295 (exit 10)
mod:c01_widen_signed_keeps_value;

func:v8 = int8(int8:x) never fails { pass x; };
func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:a = raw v32(-1i32);
    int64:w = a => int64;
    if (w != -1i64) { exit 10i32; }
    int8:b = raw v8(-100i8);
    if ((b => int64) != -100i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
