// M10 d06_short_array_literal -- a non-empty array literal shorter than its type
// claim: A non-empty array literal must match the length exactly; partial initialisation is unspellable.
// ref: meta/specs/DECISIONS.md:9918  "A **non-empty** literal must still match the"
// expect: refuse
// wrong: accepted: the missing elements read 0 (exit 10)
mod:d06_short_array_literal;

func:v64 = int64(int64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32[4]:a = [1i32, 2i32];
    if (a[raw v64(3i64)] == 0i32) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
