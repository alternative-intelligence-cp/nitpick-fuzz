// M10 l18_loop_step_near_int8_min -- `loop(-27i8, min, 100i8)`
// claim: A descending counted loop ends without computing a counter past the limit: `$` is -27 and -127.
// ref: meta/specs/CONTROL_REFERENCE.md:109  "or both, is `NITPICK-TYPE-072`; `for`, `loop` and `till` are bounded by"
// expect: run:0
// wrong: -127 - 100 computed in int8: an overflow trap (93), or a wrap (10)
mod:l18_loop_step_near_int8_min;

func:v8 = int8(int8:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int8:mn = raw v8(-127i8) - raw v8(1i8);
    int64:n = 0i64;
    int64:s = 0i64;
    loop (-27i8, mn, 100i8) { n = n + 1i64; s = s + ($ => int64); }
    if (n != 2i64) { exit 10i32; }
    if (s != -154i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
