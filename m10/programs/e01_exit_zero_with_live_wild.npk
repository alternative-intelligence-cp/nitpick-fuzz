// M10 e01_exit_zero_with_live_wild -- `exit 0` with a live `wild` allocation
// claim: A successful `exit` with live `wild` memory routes `WildLeak` (-4105) to failsafe.
// ref: meta/specs/CONTROL_REFERENCE.md:398  "`wild` or `wildx` memory triggers the `failsafe` trap instead of returning;"
// ref: meta/specs/CONTROL_REFERENCE.md:408  "non-empty `<wild-live>` routes `-4105` to `failsafe`, which may call"
// expect: run:96
// wrong: a silent success (exit 0)
mod:e01_exit_zero_with_live_wild;

func:main = int32(cstring[]:_~argv) {
    wild int8->:p = alloc(16i64);
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
