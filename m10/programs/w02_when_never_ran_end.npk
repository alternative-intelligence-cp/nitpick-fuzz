// M10 w02_when_never_ran_end -- a `when` whose condition is false at once
// claim: `end` runs only when the body never ran; `then` does not.
// ref: meta/specs/CONTROL_REFERENCE.md:137  "**`then` and `end` partition the outcomes exactly.** One of them always runs, and"
// ref: meta/specs/CONTROL_REFERENCE.md:144  "| condition false initially — body never ran | `end` |"
// expect: run:0
// wrong: `then` run for a body that never ran (10)
mod:w02_when_never_ran_end;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:x = raw v32(0i32);
    int32:t = 0i32;
    int32:e = 0i32;
    when (x > 0i32) decreases x { x = x - 1i32; } then { t = t + 1i32; } end { e = e + 1i32; }
    if (t != 0i32) { exit 10i32; }
    if (e != 1i32) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
