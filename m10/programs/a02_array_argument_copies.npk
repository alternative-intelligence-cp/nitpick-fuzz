// M10 a02_array_argument_copies -- a callee writing its array parameter
// claim: Passing `int32[4]` copies all 16 bytes; to mutate the caller's array, pass a pointer.
// ref: meta/specs/TYPE_REFERENCE.md:1050  "Passing `int32[4]` to a function copies all 16 bytes."
// expect: run:0
// wrong: a decay to a pointer: the caller sees 9 (exit 11)
mod:a02_array_argument_copies;

func:poke = int32(int32[4]:p) never fails {
    p[0i64] = 9i32;
    pass p[0i64];
};

func:main = int32(cstring[]:_~argv) {
    int32[4]:a = [1i32, 2i32, 3i32, 4i32];
    if (raw poke(a) != 9i32) { exit 10i32; }
    if (a[0i64] != 1i32) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
