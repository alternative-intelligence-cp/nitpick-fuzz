// M10 t15_concat_empty -- `string_concat` with empty operands
// claim: `string_concat` concatenates; an empty result allocates nothing.
// ref: meta/specs/BUILTIN_REFERENCE.md:238  "| `string_concat` | `(string, string) → string` | The one string operation"
// expect: run:0
// wrong: a lost operand (the check's code)
mod:t15_concat_empty;

func:main = int32(cstring[]:_~argv) {
    string:e = string_concat("", "");
    if (e.len != 0i64) { exit 10i32; }
    string:f = string_concat("ab", "");
    if (!(string_equals(f, "ab"))) { exit 11i32; }
    string:g = string_concat("", "cd");
    if (!(string_equals(g, "cd"))) { exit 12i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
