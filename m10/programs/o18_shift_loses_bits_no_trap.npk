// M10 o18_shift_loses_bits_no_trap -- an in-range shift that loses bits
// claim: Bit operations are not arithmetic and have nothing to overflow: `<<` loses the bits past its width (`1i8 << 7i8` is -128).
// ref: meta/specs/TYPE_REFERENCE.md:71  "**Bit operations are unchanged** — `&`, `|`, `^`, `~`, `<<`, `>>` are bit"
// ref: meta/specs/OP_REFERENCE.md:161  "`<<` loses the bits past its width (`1i8 << 7i8` is −128)"
// expect: run:0
// wrong: an overflow trap on a shift (93)
mod:o18_shift_loses_bits_no_trap;

func:v8 = int8(int8:x) never fails { pass x; };
func:v32 = int32(int32:x) never fails { pass x; };
func:vu32 = uint32(uint32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int8:m8 = raw v8(-127i8) - raw v8(1i8);
    if ((raw v8(64i8) << raw v8(1i8)) != m8) { exit 10i32; }
    if ((raw vu32(4294967295u32) << raw vu32(4u32)) != 4294967280u32) { exit 11i32; }
    if ((raw v32(1i32) << raw v32(31i32)) != raw v32(-2147483647i32) - raw v32(1i32)) { exit 12i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
