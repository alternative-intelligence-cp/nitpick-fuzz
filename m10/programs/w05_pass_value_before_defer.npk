// M10 w05_pass_value_before_defer -- `pass x` with a `defer` that changes `x`
// claim: `pass v` returns the `v` read at the `pass`; the defers run after it is read (D-136).
// ref: meta/specs/CONTROL_REFERENCE.md:382  "**after the exit's value is evaluated** (D-136): `pass v` returns the `v` that was read at the `pass`, whatever the defers then do."
// expect: run:0
// wrong: the seed's order, defers first: 9 (exit 10)
mod:w05_pass_value_before_defer;

func:v32 = int32(int32:x) never fails { pass x; };

func:settled = int32() never fails {
    int32:x = raw v32(0i32);
    defer { x = x + 9i32; }
    pass x;
};

func:main = int32(cstring[]:_~argv) {
    if (raw settled() != 0i32) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
