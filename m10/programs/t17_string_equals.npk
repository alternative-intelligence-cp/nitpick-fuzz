// M10 t17_string_equals -- `string_equals` on a prefix and on empties
// claim: `string_equals` is a byte-equal comparison.
// ref: meta/specs/BUILTIN_REFERENCE.md:196  "*   `string_equals(a, b)`: Byte-equal comparison."
// expect: run:0
// wrong: a prefix compare calls "ab" equal to "abc" (exit 10)
mod:t17_string_equals;

func:main = int32(cstring[]:_~argv) {
    if (string_equals("ab", "abc")) { exit 10i32; }
    if (!(string_equals("", ""))) { exit 11i32; }
    if (string_equals("abc", "abd")) { exit 12i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
