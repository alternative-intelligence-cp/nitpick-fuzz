// M10 p03_first_match_wins -- overlapping arms: a range, then a value inside it
// claim: An arm is taken under its pattern and the negations of the earlier arms: the first matching arm in source order wins.
// ref: meta/specs/VERIFICATION_REFERENCE.md:63  "> condition; a `pick` arm's pattern (a value, a range, a wildcard as the"
// ref: meta/specs/VERIFICATION_REFERENCE.md:64  "> negation of the arms before it), the negations of the earlier arms and its"
// expect: run:0
// wrong: the most specific or the last matching arm (exit 10)
mod:p03_first_match_wins;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:x = raw v32(5i32);
    int32:r = 0i32;
    pick (x) {
        (1i32..10i32) { r = 1i32; },
        (5i32) { r = 2i32; },
        (*) { r = 3i32; }
    }
    if (r != 1i32) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
