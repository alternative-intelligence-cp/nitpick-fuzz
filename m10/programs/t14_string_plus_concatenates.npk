// M10 t14_string_plus_concatenates -- `a + b` on strings
// claim: On `string`, `+` is concatenation.
// ref: meta/specs/TYPE_REFERENCE.md:355  "- Arithmetic: `+` is **concatenation**, NOT addition. No `-`, `*`, `/`, `%`."
// ref: meta/specs/TYPE_REFERENCE.md:358  "- Concatenation: `string:c = a + b;` → allocates new buffer, copies both"
// expect: run:0
// wrong: the documented operator refused, or the operands in the wrong order (exit 10)
mod:t14_string_plus_concatenates;

func:main = int32(cstring[]:_~argv) {
    string:a = "ab";
    string:b = "cd";
    string:c = a + b;
    if (!(string_equals(c, "abcd"))) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
