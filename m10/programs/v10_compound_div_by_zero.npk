// M10 v10_compound_div_by_zero -- `/=` by a run-time zero
// claim: Integer `/` and `%` by zero trap `DivByZero`, at every width and in both spellings (`/`, `/=`).
// ref: meta/specs/TYPE_REFERENCE.md:69  "**`x += y` traps identically**: both spellings route through one arithmetic"
// ref: meta/specs/TYPE_REFERENCE.md:78  "**`/` and `%` by zero still trap** (D-007), and signed `/` adds the"
// expect: run:97
// wrong: the compound spelling reaches the hardware: SIGFPE (107)
mod:v10_compound_div_by_zero;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:x = raw v32(5i32);
    x /= raw v32(0i32);
    if (x == 0i32) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
