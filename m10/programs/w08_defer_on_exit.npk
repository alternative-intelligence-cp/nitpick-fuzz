// M10 w08_defer_on_exit -- a `defer` in `main` before `exit 5`
// claim: Defers run at `exit` too, after its code is read.
// ref: meta/specs/CONTROL_REFERENCE.md:382  "Runs on **every normal exit path** — scope end, `return`, `pass`, `fail`, `relay`, `exit` —"
// ref: meta/specs/DECISIONS.md:9852  "**`fail` and `exit` follow the same rule** — the code is read at the statement,"
// expect: run:97
// wrong: the defer skipped at `exit` (exit 5)
mod:w08_defer_on_exit;

func:v32 = int32(int32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int32:z = raw v32(0i32);
    defer { int32:q = 7i32 / z; discard(q); }
    exit 5i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
