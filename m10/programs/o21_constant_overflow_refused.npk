// M10 o21_constant_overflow_refused -- `2147483647i32 + 1i32` as a constant
// claim: A folded `+ - *` whose value does not fit is NITPICK-TYPE-076 where it is written.
// ref: meta/specs/OP_REFERENCE.md:153  "**A value that does not fit is `NITPICK-TYPE-076`**"
// expect: refuse:NITPICK-TYPE-076
// wrong: accepted: folded with a wrap (exit 10)
mod:o21_constant_overflow_refused;

func:main = int32(cstring[]:_~argv) {
    int32:x = 2147483647i32 + 1i32;
    if (x < 0i32) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
