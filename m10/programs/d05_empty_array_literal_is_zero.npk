// M10 d05_empty_array_literal_is_zero -- `[]` is the zeroed array
// claim: An empty array literal where a fixed-length array is expected is that array zeroed.
// ref: meta/specs/DECISIONS.md:9915  "An empty array literal, where a fixed-length array type is expected, is that"
// expect: run:0
// wrong: the frame's previous bytes (a dirty stack) read through a `[]` array (exit 10)
mod:d05_empty_array_literal_is_zero;

func:v64 = int64(int64:x) never fails { pass x; };

func:dirty = int64() never fails {
    int64[64]:j = [];
    for (int64:k in 0i64...64i64) { j[k] = 12345i64; }
    pass j[raw v64(63i64)];
};
func:clean = int64() never fails {
    int64[64]:z = [];
    int64:s = 0i64;
    for (int64:k in 0i64...64i64) { s = s + z[k]; }
    pass s;
};

func:main = int32(cstring[]:_~argv) {
    discard(raw dirty());
    if (raw clean() != 0i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
