// M10 o17_edges_do_not_trap -- arithmetic that lands exactly on a type's edge
// claim: Only a result that does not fit traps: a result equal to the maximum or minimum is a value.
// ref: meta/specs/TYPE_REFERENCE.md:53  "Arithmetic: `+`, `-`, `*` — **overflow TRAPS** (D-210, 1.4.2b), through the"
// ref: meta/specs/TYPE_REFERENCE.md:161  "Overflow TRAPS, as with signed types (D-210)"
// expect: run:0
// wrong: a guard off by one traps at the edge (93)
mod:o17_edges_do_not_trap;

func:v8 = int8(int8:x) never fails { pass x; };
func:v32 = int32(int32:x) never fails { pass x; };
func:v64 = int64(int64:x) never fails { pass x; };
func:vu8 = uint8(uint8:x) never fails { pass x; };
func:vu64 = uint64(uint64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    if ((raw v32(2147483646i32) + raw v32(1i32)) != 2147483647i32) { exit 10i32; }
    int32:mn = raw v32(-2147483647i32) - raw v32(1i32);
    if ((mn + raw v32(1i32)) != -2147483647i32) { exit 11i32; }
    int8:m8 = raw v8(-127i8) - raw v8(1i8);
    if ((m8 + raw v8(127i8)) != -1i8) { exit 12i32; }
    if ((raw vu8(254u8) + raw vu8(1u8)) != 255u8) { exit 13i32; }
    if ((raw v64(-3037000499i64) * raw v64(3037000499i64)) != -9223372030926249001i64) { exit 14i32; }
    if ((raw vu64(4294967295u64) * raw vu64(4294967297u64)) != ~0u64) { exit 15i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
