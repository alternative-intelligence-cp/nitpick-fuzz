// M10 r10_result_literal_both -- `return Result{ err: E1, value: 3 }`
// claim: The literal form returns a value and an error at once; it is an error.
// ref: meta/specs/CONTROL_REFERENCE.md:332  "the literal form, the only way to return a value"
// ref: meta/specs/TYPE_REFERENCE.md:1332  "| `return Result{err: errCode, value: retVal};` | (literal, no desugar) | Special: return both value AND error |"
// expect: run:0
// wrong: the value taken over the error (11)
mod:r10_result_literal_both;

error:E1;
func:f = int32() { return Result{ err: E1, value: 3i32 }; };

func:main = int32(cstring[]:_~argv) {
    Result<int32>:r = f();
    if (!r.is_error) { exit 10i32; }
    if ((f() ?| 9i32) != 9i32) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (E1) { exit 81i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
