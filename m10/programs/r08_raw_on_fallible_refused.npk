// M10 r08_raw_on_fallible_refused -- `raw f()` where `f` may fail
// claim: `raw` is licensed only on a `never fails` callee (TYPE-042).
// ref: meta/specs/TYPE_REFERENCE.md:1382  "> - `raw` = unwrap a `Result<T>`'s value. **D-163 (settled; the licence is ON — `NITPICK-TYPE-042`)**: licensed only"
// expect: refuse:NITPICK-TYPE-042
// wrong: accepted: an unchecked read of the zeroed value (exit 10)
mod:r08_raw_on_fallible_refused;

error:E1;
func:f = int32() { fail E1; };

func:main = int32(cstring[]:_~argv) {
    int32:v = raw f();
    if (v == 0i32) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (E1) { exit 81i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
