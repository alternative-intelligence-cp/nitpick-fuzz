// M10 m07_nan_comparisons -- `==`, `!=`, `<` with a NaN operand
// claim: Float comparisons are ordered, except `!=`, which is `une`, so NaN != NaN is true.
// ref: meta/specs/TYPE_REFERENCE.md:187  "- Comparison: `fcmp` ordered predicates, except `!=` which is `une` so that"
// ref: meta/specs/TYPE_REFERENCE.md:2054  "| `!=` | not equal | `icmp ne`/`fcmp one` | |"
// expect: run:0
// wrong: `!=` lowered as the ordered `one`: NaN != NaN is false (exit 10)
mod:m07_nan_comparisons;

func:vf64 = flt64(flt64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    flt64:z = raw vf64(0.0f64);
    flt64:n = z / z;
    if (!(n != n)) { exit 10i32; }
    if (n == n) { exit 11i32; }
    if (n < raw vf64(1.0f64)) { exit 12i32; }
    if (n > raw vf64(1.0f64)) { exit 13i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
