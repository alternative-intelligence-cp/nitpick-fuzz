// M10 l27_continue_in_for -- `continue` in a `for` range
// claim: `continue` skips to the next iteration.
// ref: meta/specs/CONTROL_REFERENCE.md:100  "Nitpick supports `break;` to exit the innermost loop, and `continue;` to skip to the next iteration across all loop types."
// expect: run:0
// wrong: an iteration skipped twice, or none (exit 10)
mod:l27_continue_in_for;

func:main = int32(cstring[]:_~argv) {
    int64:s = 0i64;
    for (int64:i in 0i64...5i64) {
        if (i == 2i64) { continue; }
        s = s + i;
    }
    if (s != 8i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
