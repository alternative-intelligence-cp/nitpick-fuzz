// M10 l08_for_inclusive_to_int64_max -- `for (int64:i in max-2..max)`
// claim: An inclusive range ending at the int64 maximum visits it and ends.
// ref: meta/specs/OP_REFERENCE.md:375  "| `..` | Inclusive Range | Inclusive range `[a, b]`. Used in `for` and `pick`. | `0..10` |"
// ref: meta/specs/CONTROL_REFERENCE.md:109  "or both, is `NITPICK-TYPE-072`; `for`, `loop` and `till` are bounded by"
// expect: run:0
// wrong: the counter stepped past the maximum (93, or T)
mod:l08_for_inclusive_to_int64_max;

func:v64 = int64(int64:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    int64:hi = raw v64(9223372036854775807i64);
    int64:lo = hi - raw v64(2i64);
    int64:n = 0i64;
    int64:s = 0i64;
    for (int64:i in lo..hi) { n = n + 1i64; s = s + (i - lo); }
    if (n != 3i64) { exit 10i32; }
    if (s != 3i64) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
