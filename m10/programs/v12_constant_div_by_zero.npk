// M10 v12_constant_div_by_zero -- `5i32 / 0i32` as a constant
// claim: A constant division by zero is refused (TYPE-004).
// ref: meta/specs/OP_REFERENCE.md:164  "a constant `MIN / −1` or `MIN % −1` is refused as a constant division by"
// expect: refuse:NITPICK-TYPE-004
// wrong: accepted: a run-time trap (97) or a folded value (10)
mod:v12_constant_div_by_zero;

func:main = int32(cstring[]:_~argv) {
    int32:x = 5i32 / 0i32;
    if (x == 0i32) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
