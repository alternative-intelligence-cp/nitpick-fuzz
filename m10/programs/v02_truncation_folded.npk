// M10 v02_truncation_folded -- `/` and `%` on negative constants, folded
// claim: A constant expression means what the run time means: the folder divides as `sdiv` does.
// ref: meta/specs/OP_REFERENCE.md:148  "**A constant expression means what the run time means (D-310, D-311; 1.5.8b"
// ref: meta/specs/OP_REFERENCE.md:160  "- Every other operation the folder evaluates is also the machine's answer:"
// expect: run:0
// wrong: a folder that floors, or rounds (the check's code)
mod:v02_truncation_folded;

fixed int32:Q1 = -7i32 / 2i32;
fixed int32:Q2 = 7i32 / -2i32;
fixed int32:R1 = -7i32 % 2i32;
fixed int32:R2 = 7i32 % -2i32;

func:main = int32(cstring[]:_~argv) {
    if (Q1 != -3i32) { exit 10i32; }
    if (Q2 != -3i32) { exit 11i32; }
    if (R1 != -1i32) { exit 12i32; }
    if (R2 != 1i32) { exit 13i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
