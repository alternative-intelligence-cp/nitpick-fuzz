// M10 c26_constant_overflow_contextual -- `int8:x = 100 + 100;`
// claim: A constant that does not fit its type is TYPE-076; an unsuffixed pair takes its width from the context.
// ref: meta/specs/OP_REFERENCE.md:155  "so `int8:x = 100 + 100;` is refused too"
// expect: refuse:NITPICK-TYPE-076
// wrong: accepted: wrapped to -56 (exit 10)
mod:c26_constant_overflow_contextual;

func:main = int32(cstring[]:_~argv) {
    int8:x = 100 + 100;
    if (x < 0i8) { exit 10i32; }
    exit 11i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
