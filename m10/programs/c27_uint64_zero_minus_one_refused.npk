// M10 c27_uint64_zero_minus_one_refused -- `0u64 - 1u64`
// claim: `0u64 - 1u64` is refused (TYPE-076); the maximum is `~0u64`.
// ref: meta/specs/LEXICAL_REFERENCE.md:331  "(NITPICK-TYPE-076). `uint64`'s upper half is constructed with bit operations,"
// expect: refuse:NITPICK-TYPE-076
// wrong: accepted: wrapped (exit 10)
mod:c27_uint64_zero_minus_one_refused;

func:main = int32(cstring[]:_~argv) {
    uint64:m = 0u64 - 1u64;
    if (m == ~0u64) { exit 10i32; }
    exit 11i32;
};

