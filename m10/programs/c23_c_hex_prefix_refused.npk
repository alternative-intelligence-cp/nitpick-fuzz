// M10 c23_c_hex_prefix_refused -- `0xFF`
// claim: The C prefixes were removed: `0xFF` is a bad-digit error at the `x`.
// ref: meta/specs/LEXICAL_REFERENCE.md:346  "`0xFF` is a bad-digit error at the `x`"
// expect: refuse:NITPICK-LEX-003
// wrong: accepted: C's reading (exit 10)
mod:c23_c_hex_prefix_refused;

func:main = int32(cstring[]:_~argv) {
    int32:x = 0xFF;
    if (x == 255i32) { exit 10i32; }
    exit 11i32;
};

