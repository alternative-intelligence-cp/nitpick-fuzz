// M10 q09_if_else_both_pass -- an `if`/`else` whose arms both pass
// claim: An `if`/`else` completes only if an arm does: two passing arms leave nothing after.
// ref: meta/specs/CONTROL_REFERENCE.md:342  "`if`/`else` completes if either arm does, a `pick` if any arm's body does (an"
// expect: run:0
// wrong: refused FLOW-001: an over-restriction
mod:q09_if_else_both_pass;

func:v64 = int64(int64:x) never fails { pass x; };

func:f = int64(int64:x) never fails {
    if (x > 0i64) { pass 1i64; } else { pass 2i64; }
};

func:main = int32(cstring[]:_~argv) {
    if (raw f(raw v64(0i64)) != 2i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
