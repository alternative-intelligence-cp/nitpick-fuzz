// M10 f02_flt32_rounds_in_flt32 -- `16777216.0f32 + 1.0f32`
// claim: `flt32` is `float`: its arithmetic rounds at 24 significand bits.
// ref: meta/specs/TYPE_REFERENCE.md:172  "| `flt32` | `float` | 4 bytes | 4 | everything |"
// expect: run:0
// wrong: the sum kept in double precision: 16777217 (exit 10)
mod:f02_flt32_rounds_in_flt32;

func:vf32 = flt32(flt32:x) never fails { pass x; };

func:main = int32(cstring[]:_~argv) {
    flt32:a = raw vf32(16777216.0f32);
    flt32:b = a + raw vf32(1.0f32);
    if (b != a) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
