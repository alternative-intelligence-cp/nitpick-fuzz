// M10 e03_exit_outside_main_refused -- `exit` in an ordinary function
// claim: `exit` may appear only in `main` or `failsafe`.
// ref: meta/specs/CONTROL_REFERENCE.md:393  "**`exit code;`** terminates the process, and may appear only in `main` or"
// expect: refuse
// wrong: accepted: a process exit from a library function (exit 3)
mod:e03_exit_outside_main_refused;

func:f = NIL() never fails {
    exit 3i32;
};

func:main = int32(cstring[]:_~argv) {
    drop f();
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
