// M10 d07_result_literal_omits_err -- `Result{ value: v }` with the error omitted
// claim: Either field of a Result literal may be omitted and defaults to the zero for its side: an omitted `err` is success.
// ref: meta/specs/TYPE_REFERENCE.md:1340  "**Either field may be omitted**"
// ref: meta/specs/CONTROL_REFERENCE.md:332  "the literal form, the only way to return a value"
// expect: run:0
// wrong: the omitted error field read as a failure (10) or the value lost (11)
mod:d07_result_literal_omits_err;

func:f = int32() {
    return Result{ value: 7i32 };
};

func:main = int32(cstring[]:_~argv) {
    Result<int32>:r = f();
    if (r.is_error) { exit 10i32; }
    if ((f() ?| 0i32) != 7i32) { exit 11i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest) { exit 91i32; },
        (HeapOom) { exit 92i32; },
        (IntOverflow) { exit 93i32; },
        (OutOfBounds) { exit 94i32; },
        (Unreachable) { exit 95i32; },
        (WildLeak) { exit 96i32; },
        (DivByZero) { exit 97i32; },
        (DivOverflow) { exit 98i32; },
        (StackExhausted) { exit 106i32; },
        (MachineFault) { exit 107i32; },
        (LimitViolated) { exit 108i32; },
        (DecreasesViolated) { exit 109i32; },
        (TbbErr) { exit 110i32; },
        (ShiftRange) { exit 111i32; },
        (CastRange) { exit 112i32; },
        (BadStep) { exit 113i32; },
        (BorrowOverlap) { exit 114i32; },
        (RequiresViolated) { exit 115i32; },
        (EnsuresViolated) { exit 116i32; },
        (InvariantViolated) { exit 117i32; },
        (*) { exit 99i32; }
    }
    exit 9i32;
};
